# Copia este archivo como .env.local y completa con los datos del proyecto Supabase de dentro (dev).
# Solo variables PÚBLICAS: todo lo que empieza con VITE_ termina en el JavaScript del navegador.
# Nunca pongas aquí la clave de servicio (service_role / sb_secret_) ni contraseñas de la base.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL base para los enlaces de correo. Si se deja vacía se usa la del navegador.
VITE_SITE_URL=
# Registro de dueños: abierto por omisión (D4). «closed» oculta el formulario.
# VITE_SIGNUP_MODE=closed
